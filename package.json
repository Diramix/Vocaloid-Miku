{
	"name": "vocaloid-miku",
	"license": "CC0-1.0",
	"packageManager": "pnpm@12.9.1",
	"scripts": {
		"dev": "ymtm dev",
		"build": "ymtm build",
		"build:nextmusic": "ymtm build nextmusic",
		"build:pulsesync": "ymtm build pulsesync",
		"format": "biome format --write .",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit"
	},
	"build": {
		"package": [
			"nextmusic",
			"pulsesync"
		]
	},
	"nextmusic": {
		"tarGz": {
			"artifactName": "Vocaloid-Miku_${addon.version}_${build.package}.tar.gz"
		}
	},
	"pulsesync": {
		"zip": {
			"artifactName": "Vocaloid-Miku_${addon.version}_${build.package}.zip"
		},
		"pext": {
			"artifactName": "Vocaloid-Miku_${addon.version}_${build.package}.pext"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@diram1x/ymtm": "^4.2.0",
		"typescript": "^7.0.2"
	}
}
