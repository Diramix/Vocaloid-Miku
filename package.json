{
	"name": "vocaloid-miku",
	"addonName": "Vocaloid Miku!",
	"version": "1.15.0",
	"description": "Hatsune Miku: Project DIRA F",
	"author": "diram1x",
	"license": "CC0-1.0",
	"packageManager": "pnpm@12.16.1",
	"scripts": {
		"dev": "nmtools dev",
		"build": "nmtools build",
		"build:nextmusic": "nmtools build nextmusic",
		"format": "biome format --write .",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit"
	},
	"build": {
		"targets": ["nextmusic"]
	},
	"nextmusic": {
		"tarGz": {
			"artifactName": "Vocaloid-Miku_${addon.version}_${build.package}.tar.gz"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@web-next-music/nmtools": "^5.1.0",
		"typescript": "^7.0.2"
	}
}
